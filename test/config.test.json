{
  "out": "output",
  "alwaysBlur": [".sensitive"],
  "sessions": {
    "user": [
      { "open": "./page.html" },
      { "type": "input[type=email]", "text": "user@example.com" },
      { "type": "input[type=password]", "text": "{{TEST_PASSWORD}}" },
      { "click": "#login button" },
      { "run": "node -e \"require('fs').appendFileSync('otp.log','Code for user: 123456\\n')\"" },
      { "otp": { "file": "otp.log", "pattern": "Code for user: (\\d{6})", "into": "input[autocomplete=one-time-code]", "submit": { "clickText": "Verify" } } },
      { "wait": "#app" }
    ]
  },
  "shots": [
    { "name": "t01_after_login", "session": "user", "highlight": [{ "selector": ".open", "label": "1" }] },
    { "name": "t02_modal", "session": "user", "steps": [{ "clickText": "Add" }, { "wait": ".modal" }], "element": ".modal", "padding": 10 },
    { "name": "t03_mobile", "session": "user", "viewport": { "width": 390, "height": 600 } },
    { "name": "t04_expected_failure", "session": "user", "element": ".does-not-exist", "higlight": [".typo-on-purpose"] }
  ]
}
